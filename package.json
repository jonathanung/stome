{
  "name": "stome",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:sqlite": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "check:schema": "node --experimental-sqlite --experimental-strip-types scripts/check-schema.ts",
    "check:harness": "node --experimental-sqlite --experimental-strip-types --import ./scripts/register-harness.mjs --test scripts/check-harness.test.ts",
    "companion": "node --experimental-strip-types --import ./scripts/register-harness.mjs companion/server.ts",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm run check:schema && npm run check:harness && npm test && npm run check:writes",
    "test": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "check:writes": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-writes.ts"
  },
  "engines": {
    "node": "22.23.4"
  },
  "private": true
}
