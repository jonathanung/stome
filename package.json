{
  "name": "stome",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:sqlite": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "check:schema": "node --experimental-sqlite --experimental-strip-types scripts/check-schema.ts",
    "check:commit": "node --experimental-sqlite --experimental-strip-types --import ./scripts/register-harness.mjs scripts/check-commit.ts",
    "check:harness": "node --experimental-sqlite --experimental-strip-types --import ./scripts/register-harness.mjs --test scripts/check-harness.test.ts",
    "companion": "node --experimental-strip-types --import ./scripts/register-harness.mjs companion/server.ts",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm run check:schema && npm run check:commit && npm run check:harness"
  },
  "engines": {
    "node": "22.23.4"
  },
  "private": true
}
